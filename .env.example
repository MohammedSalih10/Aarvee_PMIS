PORT=3000
NODE_ENV=development

# Generate a real secret before deploying, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start if this is the placeholder or shorter than 32 characters.
JWT_SECRET=change-this-to-a-long-random-string

# --- Production (NODE_ENV=production) ---
# With docker-compose.yml, NODE_ENV/HOST/TRUST_PROXY are set by the compose file and override these.
# Behind nginx: listen on loopback only and trust its X-Forwarded-For header.
#HOST=127.0.0.1
#TRUST_PROXY=1

# Demo accounts/projects/financials are seeded only outside production
# (or with SEED_DEMO=true). On an empty production database the first admin
# comes from these two; remove ADMIN_PASSWORD from .env after the first start.
# Password: 8-72 characters, letters and numbers.
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=
